# Copie este arquivo para .env e ajuste os valores do ambiente.
# Nunca versione o arquivo .env.

SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de dados PostgreSQL 16 (oficial)
# Para usar SQLite em modo legado, comente ou deixe DB_ENGINE vazio.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=baros
DB_USER=baros
DB_PASSWORD=troque-por-senha-forte
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# URL pública do sistema (usada fora de requisição HTTP, ex.: links em PDFs/webhooks)
SITE_URL=http://localhost:8000
USE_HTTPS=False

